{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run check",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{mirror/**,public/**,docs/research/bca-homepage/source.html}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index?sitePath=$1" }
  ]
}
